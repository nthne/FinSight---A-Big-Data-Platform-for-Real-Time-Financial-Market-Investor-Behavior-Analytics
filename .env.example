# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Set to local to send market refreshes through the local API and Kafka gateway.
VITE_MARKET_REFRESH_MODE=local

# Server-side Supabase configuration
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Internal analytics ingestion boundary; never prefix these with VITE_
INGESTION_GATEWAY_URL=http://localhost:18080
INGESTION_GATEWAY_TOKEN=local-integration-token
ANALYTICS_USER_SALT=replace_with_a_random_secret

# Kafka producer settings used only by the ingestion service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=finsight-ingestion
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# MinIO or S3-compatible storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=fin-sight

# MongoDB analytics serving layer; use a least-privilege reader URI in the app.
MONGO_URI=mongodb://finsight_reader:replace_me@mongodb:27017/finsight?authSource=finsight
MONGO_DATABASE=finsight
